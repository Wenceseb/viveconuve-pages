{
  "name": "viveconuve",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static publishing pipeline for ViveConUve",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test",
    "check": "npm run build && npm test && node scripts/check.mjs",
    "format": "prettier --write \"scripts/**/*.mjs\" \"src/**/*.{js,css,html}\" \"tests/*.mjs\" \"*.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"src/**/*.{js,css,html}\" \"tests/*.mjs\" \"*.json\" \".github/workflows/*.yml\"",
    "check:runtime": "node scripts/check-runtime.mjs",
    "prebuild": "npm run check:runtime"
  },
  "devDependencies": {
    "parse5": "8.0.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5"
  }
}
