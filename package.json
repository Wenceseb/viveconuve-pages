{
  "name": "viveconuve",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static publishing pipeline for ViveConUve",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test",
    "check": "npm run build && npm test && node scripts/check.mjs",
    "format": "prettier --write \"scripts/**/*.mjs\" \"src/**/*.{js,css,html}\" \"public/assets/{tools,library,editorial}/*.{js,css}\" \"tests/*.mjs\" \"*.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"src/**/*.{js,css,html}\" \"public/assets/{tools,library,editorial}/*.{js,css}\" \"tests/*.mjs\" \"*.json\" \".github/workflows/*.yml\"",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "check:hybrid": "node scripts/hybrid-browser-check.mjs",
    "prebuild": "npm run check:runtime",
    "check:agenda": "node scripts/agenda-browser-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "parse5": "8.0.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5"
  }
}
